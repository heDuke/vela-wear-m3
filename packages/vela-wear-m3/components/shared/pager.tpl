<div class="demo-page" if="{{demoMode === 'hpager' || demoMode === 'vpager'}}" onswipe="onPageSwipe"><div class="demo-nav">
<!-- #if !round -->
<div class="nav-back" onclick="goBack"><image class="nav-arrow" src="/common/img/back_onSurface_24.png"></image></div>
<!-- #endif -->
<text class="demo-title">分页</text></div><div class="pager-area" ontouchstart="pagerStart" ontouchmove="pagerMove" ontouchend="pagerEnd" onswipe="pagerOwnSwipe"><div class="pager-content" style="{{pageContentStyle}}"><text class="pager-heading">{{pageIndex+1}} / {{pageCount}}</text><image class="pager-icon" src="/common/img/star_primary_24.png"></image><text class="demo-label">{{demoMode==='hpager'?'左右滑动':'上下滑动'}}
拖过四分之一翻页</text></div><div class="pager-neighbor" style="{{pagerNeighborStyle}}"><text class="pager-heading">{{pagerNeighbor+1}} / {{pageCount}}</text><image class="pager-icon" src="/common/img/star_primary_24.png"></image><text class="demo-label">{{demoMode==='hpager'?'左右滑动':'上下滑动'}} · 25% 翻页</text></div></div><div class="demo-controls" onclick="togglePageCount"><text class="t-labelS c-pri">{{pageCount===8?'改为三页':'改为八页'}}</text></div><div class="pager-box" style="{{pagerBox}}"><image class="pager-background" src="{{pagerBackground}}"></image><div class="page-dot" style="{{$item.st}}" for="{{dots}}" tid="id"></div><div class="selected-dot" style="{{$item.st}}" for="{{worm}}" tid="id"></div></div></div>
