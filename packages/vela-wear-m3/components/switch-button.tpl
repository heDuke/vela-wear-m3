<div class="switch-card {{@{item}.disabled ? 'switch-disabled' : @{item}.checked ? 'bpc' : 'bt'}}" onclick="toggleSwitch(@{index})"><div class="switch-heading"><image class="switch-leading {{@{item}.disabled ? 'disabled-label' : ''}}" if="{{@{item}.leading}}" src="/common/img/wifi_onPrimaryC_24.png"></image><div class="switch-labels"><text class="switch-label {{@{item}.disabled ? 'disabled-label' : ''}}">{{@{item}.label}}</text><text class="switch-sub {{@{item}.disabled ? 'disabled-label' : @{item}.checked ? 'switch-secondary-on' : ''}}">{{@{item}.caption}}</text></div></div><image class="switch-art" src="{{@{item}.src}}"></image></div>
