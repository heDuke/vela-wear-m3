<div class="switch-press" style="{{feedback[@{item}.id] || {opacity:1}}}" ontouchstart="pressSwitch(@{index})" ontouchend="releaseSwitch(@{index})" ontouchmove="cancelPress" onclick="toggleSwitch(@{index})"><div class="switch-card {{@{item}.disabled ? 'switch-disabled' : @{item}.checked ? 'bpc' : 'bt'}}"><div class="switch-heading"><image class="switch-leading {{@{item}.disabled ? 'disabled-label' : ''}}" if="{{@{item}.leading}}" src="{{@{item}.disabled ? '/common/img/wifi_onSurface_24.png' : '/common/img/wifi_primary_24.png'}}"></image><div class="switch-labels"><text class="switch-label {{@{item}.disabled ? 'disabled-label' : ''}}">{{@{item}.label}}</text><text class="switch-sub {{@{item}.disabled ? 'disabled-label' : @{item}.checked ? 'switch-secondary-on' : ''}}">{{@{item}.caption}}</text></div></div><div class="switch-ctl"><image class="switch-art" src="{{@{item}.src}}"></image></div></div></div>
