<div class="slider-control" ontouchstart="controlStart" ontouchend="controlEnd">
<!-- #if pill -->
<text class="slider-top-value">{{lvl}}</text>
<div class="slider-track-slot"><stack class="slider-rail"><div class="slider-unselected"></div><div class="slider-selected {{sliderMode===2 ? 'slider-dim' : ''}}" style="{{sliderStyle}}"></div><div class="slider-separator" style="{{$item.st}}" for="{{separators}}" tid="id"></div></stack></div><div class="slider-actions"><div class="slider-key" style="{{feedback.dec || {opacity:1}}}" ontouchstart="press('dec')" ontouchend="release('dec')" ontouchmove="cancelPress" onclick="dec"><image class="ic24 {{lvl===0 ? 'disabled-label' : ''}}" src="/common/img/remove_primary_24.png"></image></div><div class="slider-key" style="{{feedback.inc || {opacity:1}}}" ontouchstart="press('inc')" ontouchend="release('inc')" ontouchmove="cancelPress" onclick="inc"><image class="ic24 {{lvl===5 ? 'disabled-label' : ''}}" src="/common/img/add_primary_24.png"></image></div></div>
<!-- #else -->
<div class="slider-key" style="{{feedback.dec || {opacity:1}}}" ontouchstart="press('dec')" ontouchend="release('dec')" ontouchmove="cancelPress" onclick="dec"><image class="ic24 {{lvl===0 ? 'disabled-label' : ''}}" src="/common/img/remove_primary_24.png"></image></div><div class="slider-track-slot"><stack class="slider-rail"><div class="slider-unselected"></div><div class="slider-selected {{sliderMode===2 ? 'slider-dim' : ''}}" style="{{sliderStyle}}"></div><div class="slider-separator" style="{{$item.st}}" for="{{separators}}" tid="id"></div></stack></div><div class="slider-key" style="{{feedback.inc || {opacity:1}}}" ontouchstart="press('inc')" ontouchend="release('inc')" ontouchmove="cancelPress" onclick="inc"><image class="ic24 {{lvl===5 ? 'disabled-label' : ''}}" src="/common/img/add_primary_24.png"></image></div>
<!-- #endif -->
</div>
