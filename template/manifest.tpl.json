{
  "package": "com.velam3.demo",
  "name": "M3演示",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1200,
  "minAPILevel": 1,
  "icon": "/common/logo.png",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.prompt" },
    { "name": "system.vibrator" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": $[W]
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index":   { "component": "index", "launchMode": "singleTask" },
      "pages/buttons": { "component": "buttons" },
      "pages/cards":   { "component": "cards" },
      "pages/list":    { "component": "list" },
      "pages/edge":    { "component": "edge" },
      "pages/time":    { "component": "time" },
      "pages/toggles": { "component": "toggles" },
      "pages/dialogs": { "component": "dialogs" },
      "pages/motion":  { "component": "motion" }
    }
  },
  "display": { "backgroundColor": "#000000" }
}
